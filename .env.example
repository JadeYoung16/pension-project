# Copy this file to .env and fill in real values.
# .env is gitignored; .env.example is the template that lives in Git.

# PostgreSQL connection
POSTGRES_USER=pension
POSTGRES_PASSWORD=<choose-a-password>
POSTGRES_DB=pension
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Snowflake connection
SNOWFLAKE_ACCOUNT=YOUR_ORG-YOUR_ACCOUNT
SNOWFLAKE_USER=YOUR_USER
SNOWFLAKE_PASSWORD=your_password_here
SNOWFLAKE_ROLE=PENSION_DEVELOPER
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=PENSION_DEV
SNOWFLAKE_SCHEMA=RAW_ONCAP

