[sqlfluff]
dialect = snowflake
templater = dbt
max_line_length = 120

# Rules we explicitly disable:
#   LT01 — "as" spacing (we use multi-space column alignment intentionally)
#   ST06 — SELECT column ordering (overly prescriptive)
#   LT05 — line length (covered by max_line_length above)
#   AL01 — explicit table aliasing (from x as y) is an intentional project convention
#   RF02 — false positives on incremental {{ this }} self-reference subqueries
#          (single-table, no real ambiguity; sqlfluff miscounts FROM context)
exclude_rules = LT01, ST06, LT05, AL01, RF02

[sqlfluff:indentation]
indent_unit = space
tab_space_size = 4

[sqlfluff:layout:type:end_of_file]
spacing_before = single
